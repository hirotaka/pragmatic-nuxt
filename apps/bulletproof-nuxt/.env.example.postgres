# Select the NuxtHub PostgreSQL dialect.
NUXT_HUB_DB_DIALECT=postgresql

# Optional local PGlite storage directory.
# Leave DATABASE_URL unset to use PGlite locally.
NUXT_HUB_DIR=.data/pglite

# Neon Cloudflare deployments only.
# Configure this as a deployment secret; do not commit a real connection string.
# DATABASE_URL=postgresql://user:password@host/database

# Session (required for nuxt-auth-utils)
# Must be at least 32 characters long
NUXT_SESSION_PASSWORD="your-secure-session-password-at-least-32-characters-long"
