{
  "name": "bulletproof-nuxt",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bash -lc 'if [[ -z \"${WORKERS_CI_BRANCH:-}\" || \"$WORKERS_CI_BRANCH\" == \"main-worker\" ]]; then pnpm run build:production; else pnpm run build:preview; fi'",
    "build:production": "rm -rf .nuxt && NODE_OPTIONS=--max-old-space-size=4096 NITRO_PRESET=cloudflare_module nuxt build",
    "build:preview": "rm -rf .nuxt && NODE_OPTIONS=--max-old-space-size=4096 NITRO_PRESET=cloudflare_module CLOUDFLARE_ENV=preview nuxt build --envName preview",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:evidence:exploration": "TEST_EVIDENCE_LIFECYCLE=exploration vitest run --config vitest.evidence.config.ts",
    "test:evidence:characterization": "TEST_EVIDENCE_LIFECYCLE=characterization vitest run --config vitest.evidence.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:prepare": "rm -rf .data/e2e .nuxt && nuxt build --dotenv .env.test",
    "test:e2e:preview": "nuxt preview --dotenv .env.test -p 3100",
    "test:e2e:dev": "nuxt dev --dotenv .env.test -p 3100",
    "test:e2e:ci": "pnpm test:e2e:prepare && start-server-and-test test:e2e:preview http://localhost:3100 'NUXT_PORT=3100 pnpm test:e2e'",
    "db:generate": "rm -rf .nuxt && NUXT_HUB_DB_APPLY_MIGRATIONS=false nuxt db generate",
    "db:migrate": "rm -rf .nuxt && nuxt db migrate",
    "db:reset": "rm -rf .data/db && pnpm db:migrate",
    "db:clear:d1": "wrangler d1 execute bulletproof-nuxt --remote --file db/clear.sql",
    "db:clear:d1:preview": "wrangler d1 execute bulletproof-nuxt-preview --remote --file db/clear.sql",
    "deploy:cloudflare": "sh -c 'pnpm exec wrangler --cwd .output/server d1 migrations apply DB --remote && pnpm exec wrangler --cwd .output deploy --keep-vars'",
    "deploy:cloudflare:preview": "sh -c 'pnpm exec wrangler --cwd .output/server d1 migrations apply DB --remote && pnpm exec wrangler --cwd .output versions upload'",
    "lint": "eslint .",
    "type-check": "nuxt typecheck"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@libsql/client": "^0.17.0",
    "@neondatabase/serverless": "^1.0.0",
    "@nuxthub/core": "0.10.8",
    "@pinia/nuxt": "^0.11.3",
    "@regle/core": "^1.0.0",
    "@regle/nuxt": "^1.0.0",
    "@regle/rules": "^1.0.0",
    "@regle/schemas": "^1.13.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.18",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.0",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.0.0",
    "nuxt": "^4.5.1",
    "nuxt-auth-utils": "^0.5.25",
    "pinia": "^3.0.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "reka-ui": "^2.6.0",
    "shadcn-nuxt": "^2.8.0",
    "tailwind-merge": "^3.0.0",
    "vue": "3.5.40",
    "vue-dompurify-html": "^5.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260124.0",
    "@ngneat/falso": "^8.0.2",
    "@nuxt/eslint": "^1.10.0",
    "@nuxt/test-utils": "^4.0.2",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^4.0.8",
    "@vitest/ui": "^4.0.8",
    "@vue/test-utils": "^2.4.9",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^10.0.0",
    "happy-dom": "^20.0.10",
    "lint-staged": "^17.0.0",
    "playwright": "^1.56.1",
    "start-server-and-test": "^3.0.0",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.2.0",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.0.0",
    "wrangler": "^4.60.0"
  },
  "lint-staged": {
    "*.+(ts|tsx|vue)": [
      "pnpm lint",
      "bash -c 'pnpm type-check'"
    ]
  }
}
